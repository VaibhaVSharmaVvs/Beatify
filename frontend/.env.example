# Base URL of the FastAPI backend.
# Baked in at build time — changing it requires a redeploy, not just an env edit.
VITE_API_BASE_URL=http://localhost:8000

# No Supabase keys here on purpose. The browser no longer talks to Supabase
# directly; stats are served by the backend at GET /stats, which verifies the
# caller's Spotify token first.
