# Spotify OAuth app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
REDIRECT_URI=http://localhost:8000/callback
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed by CORS.
# Defaults to common localhost dev ports if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase project credentials (Project Settings -> API).
# SUPABASE_SERVICE_KEY is the service_role key — keep it secret, server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
